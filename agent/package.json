{
  "name": "@api3-fena/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Watches posts, checks relevance with an LLM and brings signed AirnodeHub proof to the trading vault",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "request-hashes": "node scripts/request-hashes.ts",
    "fixtures": "node scripts/make-fixtures.ts",
    "fetch-prices": "node --env-file-if-exists=.env scripts/fetch-prices.ts",
    "tamper-demo": "node --env-file-if-exists=.env scripts/tamper-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "viem": "^2.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "~6.0.3"
  }
}
