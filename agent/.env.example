# Copy to agent/.env. Keys stay in .env files or the host's secret store, never in the repo or in prompts.

# replay (default, no keys needed) or live
AGENT_MODE=replay
# PORT wins when the host sets it (Fly.io, Railway); CONSOLE_PORT otherwise
CONSOLE_PORT=4173
# 127.0.0.1 locally; 0.0.0.0 on a host, behind its HTTPS proxy
CONSOLE_HOST=127.0.0.1
# The website's origins, comma-separated: only their pages may call the API (state, costs, decisions, price updates,
# faucet)
CONSOLE_ALLOWED_ORIGINS=http://localhost:8000
REPLAY_SPEED=10
# The event log and the SQLite database (costs, decisions, verdict cache, poll state, faucet limits). On a host, a
# persistent volume.
DATA_DIR=

# Live mode: Base Sepolia (84532) or a local anvil (31337). The vault address comes from
# shared/deployments/<chain id>.json; set VAULT_ADDRESS only to override it.
# For a long live run use a provider RPC, such as a free Alchemy or QuickNode Base Sepolia URL: the public
# https://sepolia.base.org rate-limits.
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
VAULT_ADDRESS=
# The agent wallet a user approves in their rule; the vault accepts triggers only from it. Its ETH pays gas and Pyth's
# update fee (10 wei per price on Base Sepolia).
AGENT_PRIVATE_KEY=

# Prices: Pyth's Hermes needs an API key since 2026-08-26 (https://docs.pyth.network, "Pyth Terminal")
PYTH_API_KEY=
HERMES_URL=https://hermes.pyth.network

# Posts: getxapi ($0.001 per call) or twitterapi.io ($0.00015 per post returned, an empty page as one)
POST_SOURCE=getxapi
GETXAPI_KEY=
TWITTERAPI_IO_KEY=

# Smart polling: every account once per due poll, shared by all rules watching it. Often during US market hours and for
# half an hour after the account posted; rarely at night, and more rarely after six quiet hours.
POLL_ACTIVE_SEC=60
POLL_QUIET_SEC=600
POLL_IDLE_SEC=900
POLL_HOT_AFTER_POST_SEC=1800
POLL_IDLE_AFTER_SEC=21600
POLL_MARKET_HOURS=09:30-16:00
POLL_TIME_ZONE=America/New_York
# Seconds between two P1 checks of one open trigger
P1_INTERVAL_SEC=30
CYCLE_INTERVAL_SEC=30

# The agent's own money (the vault guards the users'): USD for data (posts and model calls, from the cost ledger) and
# the agent wallet's ETH for gas and Pyth's fees, per UTC day
AGENT_BUDGET_USD_PER_DAY=1
AGENT_BUDGET_ETH_PER_DAY=0.005
# Below this balance the agent sends no transaction (halted mode)
AGENT_MIN_ETH=0.0005
# Hard cap on the agent's transactions per rolling hour
AGENT_MAX_TX_PER_HOUR=30
# From this share of a daily budget (or within 2x of the minimum balance), saving mode polls no new posts but still
# finishes open triggers; a used-up budget halts paid calls and transactions but expiries
AGENT_SAVING_AT_PCT=80
# A sent transaction not mined within this time is given up for the cycle (logged with its hash) and tried again later
TX_TIMEOUT_MS=90000
# Our own X account for the live stage post, watched like Trump's
DEMO_X_HANDLE=

# Claude reads each post's meaning; without a key the keyword baseline runs. Posts that name no topic never reach a
# model; Haiku reads the rest, and the large model only what Haiku is unsure about (CLASSIFIER_LARGE_MODEL=none: never).
ANTHROPIC_API_KEY=
CLASSIFIER_SMALL_MODEL=claude-haiku-5-5
CLASSIFIER_LARGE_MODEL=claude-opus-5-5
CLASSIFIER_ESCALATE_BELOW=0.7

# Demo faucet (POST /api/demo/faucet): a wallet with Base Sepolia ETH, never the agent's. Once per address per UTC day,
# FAUCET_MAX_PER_DAY in total; without the key the route answers 404.
FAUCET_PRIVATE_KEY=
FAUCET_ETH=0.0005
FAUCET_USDC=1000
FAUCET_MAX_PER_DAY=50
FAUCET_MIN_ETH=0.002

# npm run set-rule: the demo user who deposits mock USDC and sets a rule naming AGENT_PRIVATE_KEY's wallet
USER_PRIVATE_KEY=
# Defaults to config/rule.example.json
RULE_FILE=
