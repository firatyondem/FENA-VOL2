# Copy to agent/.env. Keys stay in .env files, never in the repo or in prompts.

# replay (default, no keys needed) or live
AGENT_MODE=replay
CONSOLE_PORT=4173
# Pages that may read the console's /api/state and /api/stream (the frontend), comma-separated
CONSOLE_ALLOWED_ORIGINS=http://localhost:8000
REPLAY_SPEED=10

# Live mode: Base Sepolia (84532) or a local anvil (31337). The vault address comes from
# shared/deployments/<chain id>.json; set VAULT_ADDRESS only to override it.
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
VAULT_ADDRESS=
# The agent wallet a user approves in their rule; the vault accepts triggers only from it
AGENT_PRIVATE_KEY=
# Pays TwitterAPI.io (0.01 aUSD per call) and TickerLayer (0.05 aUSD); needs testnet aUSD on Base Sepolia, no ETH
PAYER_PRIVATE_KEY=
POLL_INTERVAL_SEC=60

# The agent's own money (the vault guards the users'). The payer's aUSD pays for data, the agent wallet's ETH for gas.
# Most aUSD the payer may spend per UTC day, and most ETH the agent wallet may spend on gas per UTC day
AGENT_BUDGET_AUSD_PER_DAY=3
AGENT_BUDGET_ETH_PER_DAY=0.005
# Below these balances the agent sends no transaction and makes no paid call (halted mode)
AGENT_MIN_ETH=0.0005
PAYER_MIN_AUSD=0.2
# Hard cap on the agent's transactions per rolling hour
AGENT_MAX_TX_PER_HOUR=30
# From this share of a daily budget (or within 2x of a minimum balance), saving mode polls no new posts but still finishes
# open triggers; a used-up budget or a balance below its minimum halts all paid calls and transactions but expiries
AGENT_SAVING_AT_PCT=80
# Our own X account for the live stage post, watched like Trump's
DEMO_X_HANDLE=

# Claude reads each post's meaning; without a key the keyword baseline runs
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5-5

# npm run set-rule: the demo user who deposits mock USDC and sets a rule naming AGENT_PRIVATE_KEY's wallet
USER_PRIVATE_KEY=
# Defaults to config/rule.example.json
RULE_FILE=

# npm run tamper-demo against the deployed vault: an open ETH trigger to aim the forgeries at
TRIGGER_ID=
